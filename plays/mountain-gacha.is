@reveal() {
	let dayRng = Math:gen_rng(`{THIS_ID}{USER_ID}{Date:year()}{Date:month()}{Date:day()}`)
	let tipRng = Math:gen_rng(`{THIS_ID}{USER_ID}{Date:year()}{Date:month()}{Date:day()}:tip`)

	let idx = dayRng(0, (mountains.len - 1))
	let today = mountains[idx]
	let tip = today.tips[tipRng(0, (today.tips.len - 1))]

	let mapsUrl = `https://maps.google.com/?q={today.lat},{today.lng}`
	let mapsText = `[📍 地図で見る（Googleマップ）]({mapsUrl})`
	let shareText = `🏔今日の山ガチャ{Str:lf}今日のあなたの山は「{today.name}」（{today.reading}）でした。{Str:lf}標高{today.elevation}m ・ {today.location} ・ 難易度: {today.difficulty}{Str:lf}{THIS_URL}`

	Ui:render([
		Ui:C:container({
			align: 'center'
			children: [
				Ui:C:text({
					text: '🎲 今日の山'
					size: 1.1
					bold: true
				})
				Ui:C:mfm({
					text: `**{today.name}**`
					size: 1.6
					bold: true
				})
				Ui:C:text({
					text: today.reading
					size: 0.85
				})
				Ui:C:text({
					text: `標高 {today.elevation}m ・ {today.location}`
				})
				Ui:C:text({
					text: `難易度: {today.difficulty}`
				})
				Ui:C:container({
					bgColor: '#24331f'
					fgColor: '#ffffff'
					padding: 14
					rounded: true
					children: [
						Ui:C:mfm({
							text: `💡 ひとことTips{Str:lf}{tip}`
						})
					]
				})
				Ui:C:mfm({
					text: mapsText
				})
				Ui:C:postFormButton({
					text: '結果を投稿する'
					rounded: true
					primary: true
					form: {
						text: shareText
					}
				})
			]
		})
	])
}

@main() {
	Ui:render([
		Ui:C:container({
			align: 'center'
			children: [
				Ui:C:text({
					text: '🏔 今日の山ガチャ'
					size: 1.4
					bold: true
				})
				Ui:C:text({
					text: 'ボタンを押すと、今日のあなたの一座が選ばれます。標高・所在地・難易度・ひとことTipsつき。'
				})
				Ui:C:text({
					text: '同じ日・同じユーザーなら、何度引いても同じ山が出ます。'
					size: 0.85
				})
				Ui:C:button({
					text: '🎲 今日の山を引く'
					primary: true
					rounded: true
					onClick: reveal
				})
			]
		})
	])
}

main()
